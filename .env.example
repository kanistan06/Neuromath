APP_ENV=development
PORT=5000
PUBLIC_BASE_URL=http://127.0.0.1:5000
FLASK_SECRET_KEY=
LOG_LEVEL=INFO
SERVICE_NAME=neuromath-development

# -----------------------------------------------------------------------------
# Online application/user database: Neon PostgreSQL
# -----------------------------------------------------------------------------
DATABASE_URL=
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=2
DATABASE_POOL_RECYCLE_SECONDS=300
DATABASE_CONNECT_TIMEOUT_SECONDS=10

# -----------------------------------------------------------------------------
# Online vector database: Qdrant Cloud
# -----------------------------------------------------------------------------
VECTOR_STORE_PROVIDER=qdrant
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=neuromath_mcq_content_v1
QDRANT_TIMEOUT_SECONDS=60

RATELIMIT_ENABLED=true
RATELIMIT_STORAGE_URI=memory://
CACHE_REDIS_URL=memory://
CACHE_KEY_PREFIX=neuromath:v1

EMAIL_CHECK_DELIVERABILITY=true
PASSWORD_MIN_LENGTH=12
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=10
PASSWORD_RESET_MAX_ATTEMPTS=5
SESSION_LIFETIME_HOURS=12
ADMIN_EMAILS=kkanistan874@gmail.com

EMAIL_DELIVERY_MODE=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=kkanistan874@gmail.com
SMTP_PASSWORD=
SMTP_FROM_EMAIL=kkanistan874@gmail.com
SMTP_FROM_NAME=NeuroMath
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=15

# Run Pod
RUNPOD_API_KEY=

# Live MCQ authoring + independent MCQ review endpoint (vLLM worker)
RUNPOD_MCQ_ENDPOINT_ID=
RUNPOD_MCQ_GENERATION_MODEL=Qwen/Qwen3-4B-Instruct-2507

HF_API_KEY=
HF_BILL_TO=
HF_EMBEDDING_BATCH_SIZE=16
HF_EMBEDDING_TIMEOUT_SECONDS=120
HF_EMBEDDING_MAX_RETRIES=3
HF_EMBEDDING_RETRY_BASE_SECONDS=2

QUESTION_BANK_DIR=data/past_papers
QUESTION_BANK_REQUIRED=true
QUESTION_BANK_REQUIRE_REVIEW=true
AUTO_INGEST_ON_STARTUP=false
QUESTION_POOL_RUNTIME_ENABLED=true
QUESTION_POOL_TARGET_PER_TOPIC_LEVEL=25
INGEST_ON_QUIZ_LOAD=false

RUNPOD_TIMEOUT_SECONDS=300
RUNPOD_EMBEDDING_TIMEOUT_SECONDS=180
RUNPOD_MAX_RETRIES=6
RUNPOD_RETRY_BASE_SECONDS=3
RUNPOD_GENERATION_TEMPERATURE=0.2
RUNPOD_LLM_MAX_NEW_TOKENS=900
RUNPOD_MCQ_MAX_NEW_TOKENS=900
GENERATION_MAX_WORKERS=2
GENERATION_RETRY_ATTEMPTS=3
GENERATION_RETRY_BASE_SECONDS=2


CHUNK_TOKENIZER_MODEL=Qwen/Qwen2.5-Math-7B-Instruct
CHUNK_MIN_TOKENS=450
CHUNK_TARGET_TOKENS=450
CHUNK_MAX_TOKENS=450
CHUNK_OVERLAP_TOKENS=50
CHUNKER_VERSION=structure-token-v1
CORPUS_LABEL=ol-textbooks-v1
CORPUS_VERSION=ol-textbooks-v1-cf01d6cfb5385f53
INGEST_STATE_DIR=.state

CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=neuromath_mcq_content

RETRIEVAL_DENSE_K=12
RETRIEVAL_LEXICAL_K=12
RETRIEVAL_FINAL_K=5
LEXICAL_CACHE_SECONDS=3600

DIAGNOSTIC_GRADES=10,11
DIAGNOSTIC_TIME_LIMIT_MINUTES=120
DIAGNOSTIC_CACHE_HOURS=168
GENERATION_MAX_WORKERS=1
GENERATION_RETRY_ATTEMPTS=3
GENERATION_RETRY_BASE_SECONDS=2
GENERATION_LOCK_SECONDS=180
GENERATION_LOCK_WAIT_SECONDS=20
GENERATION_INFERENCE_CALLS_PER_QUESTION=12
GENERATION_INFERENCE_CALL_BUDGET_MAX=300

OBSERVABILITY_ENABLED=false
QUIZ_REFERENCE_DIRS=data/loadQuizRef,data/TextBooks
IMAGE_GEN_ENABLED=false
MCQ_SIMILARITY_THRESHOLD=0.84